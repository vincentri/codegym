{
  "id": "contains-duplicate",
  "title": "Contains Duplicate",
  "difficulty": "easy",
  "categories": ["hash-map", "array"],
  "descriptionMd": "Given an integer array `nums`, return `true` if some value occurs **more than once** in it, and `false` if every value is distinct.\n\n**Example 1**\n\n```\nnums = [4, 9, 2, 9]\n→ true\n```\n9 appears twice.\n\n**Example 2**\n\n```\nnums = [3, 1, 4, 5]\n→ false\n```",
  "constraints": ["1 ≤ nums.length ≤ 10⁵", "-10⁹ ≤ nums[i] ≤ 10⁹"],
  "hints": ["Checking every pair works but is quadratic. What could you remember while scanning to answer \"have I seen this before?\" instantly?"],
  "signature": {
    "functionName": "containsDuplicate",
    "params": [{ "name": "nums", "type": "int[]" }],
    "returns": "bool"
  },
  "comparator": "exact",
