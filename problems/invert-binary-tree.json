    { "input": [[2,1,3]], "expected": [2,3,1] },
    { "input": [[]], "expected": [] },
    { "input": [[1]], "expected": [1], "hidden": true },
    { "input": [[1,2]], "expected": [1,null,2], "hidden": true },
    { "input": [[1,null,2]], "expected": [1,2], "hidden": true },
    { "input": [[1,2,null,3,null,4]], "expected": [1,null,2,null,3,null,4], "hidden": true },
