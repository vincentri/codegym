    { "input": [[3,2,3,1,2,4,5,5,6],4], "expected": 4 },
    { "input": [[1],1], "expected": 1, "hidden": true },
    { "input": [[2,1],2], "expected": 1, "hidden": true },
    { "input": [[7,7,7,7],3], "expected": 7, "hidden": true },
