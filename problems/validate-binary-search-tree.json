    { "input": [[5,1,4,null,null,3,6]], "expected": false },
    { "input": [[5,4,6,null,null,3,7]], "expected": false },
    { "input": [[1]], "expected": true, "hidden": true },
    { "input": [[2,2,2]], "expected": false, "hidden": true },
